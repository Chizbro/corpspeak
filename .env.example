# Server-only: translate-and-send API. Copy to .env for local dev.
# GEMINI_API_KEY=

# Supabase — set all in Netlify (or .env) for a working app. Never expose the service role to the client.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Public (Vite; required for the browser to subscribe to Realtime). Must be set before npm run build.
# In the Supabase project, expose the `corpspeak` schema in Settings → Data API (see docs/SUPABASE.md).
# PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: retention cap for prune job (default 100). Netlify scheduled function + `npm run prune`.
# MESSAGE_RETENTION_KEEP=100

# Netlify production only: Supabase CLI `link` + `db push` (see scripts/netlify-build.sh, DEPLOY.md). Not used by the app at runtime.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=
